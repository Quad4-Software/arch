# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=@NAME@-git
pkgver=r0.g0000000
pkgrel=1
pkgdesc='Quad4 package built from git'
arch=('x86_64' 'aarch64')
url='https://github.com/@GITHUB@'
license=('Apache-2.0')
makedepends=('git' 'go' 'make')
provides=('@NAME@')
conflicts=('@NAME@')
options=('!debug')
install=@NAME@-git.install
source=('git+https://github.com/@GITHUB@.git#branch=@BRANCH@')
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/@NAME@"
	local d
	d="$(git describe --long --tags --abbrev=7 2>/dev/null || true)"
	if [ -n "$d" ]; then
		printf '%s' "$d" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
	else
		printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
	fi
}

build() {
	cd "$srcdir/@NAME@"
	export CGO_ENABLED=0
	export GOFLAGS='-mod=vendor -trimpath'
	make build VERSION="$pkgver"
}

package() {
	cd "$srcdir/@NAME@"
	make DESTDIR="$pkgdir" PREFIX=/usr install
}
