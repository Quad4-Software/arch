# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=meshchatx-git
pkgver=4.8.5.r0.g0000000
pkgrel=1
pkgdesc='All-in-one Reticulum client, built from git'
arch=('x86_64' 'aarch64')
url='https://github.com/Quad4-Software/MeshChatX'
license=('0BSD' 'MIT')
depends=('gtk4' 'webkitgtk-6.0' 'libsoup3' 'gst-plugins-base' 'gst-plugins-good' 'xdg-utils')
makedepends=('git' 'go' 'nodejs' 'pnpm' 'python' 'python-pip' 'python-setuptools' 'python-wheel' 'go-task' 'gtk4' 'webkitgtk-6.0' 'libsoup3' 'gst-plugins-base')
optdepends=('noto-fonts-emoji: color emoji in the UI')
provides=('meshchatx' 'reticulum-meshchatx')
conflicts=('meshchatx-bin' 'meshchatx')
options=('!strip' '!debug')
install=meshchatx-git.install
source=('git+https://github.com/Quad4-Software/MeshChatX.git#branch=master')
source_x86_64=('tinygo-0.42.0-linux-amd64.tar.gz::https://github.com/tinygo-org/tinygo/releases/download/v0.42.0/tinygo0.42.0.linux-amd64.tar.gz')
source_aarch64=('tinygo-0.42.0-linux-arm64.tar.gz::https://github.com/tinygo-org/tinygo/releases/download/v0.42.0/tinygo0.42.0.linux-arm64.tar.gz')
sha256sums=('SKIP')
sha256sums_x86_64=('b87688fa2e19cee7d813cad7fd7dadb71dff3198e47125aba66ba4af5e490438')
sha256sums_aarch64=('f2f3f863e63728b87772e7306bd6030df6e6c89773a7082eb0122113cf9e453d')

pkgver() {
	cd "$srcdir/MeshChatX"
	local d
	d="$(git describe --long --tags --abbrev=7 2>/dev/null || true)"
	if [ -n "$d" ]; then
		printf '%s' "$d" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
	else
		printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
	fi
}

prepare() {
	cd "$srcdir/MeshChatX"
	export PNPM_HOME="$srcdir/.pnpm-home"
	local venv="$srcdir/MeshChatX/.build-venv"

	pnpm install --frozen-lockfile

	python -m venv "$venv"
	# shellcheck disable=SC1091
	. "$venv/bin/activate"
	pip install --upgrade pip setuptools wheel "uv==0.11.15"
	uv lock --check
	# Pin the venv interpreter: uv otherwise grabs the newest managed
	# CPython (3.15.0b1), where the locked pyyaml sdist build segfaults.
	uv sync --group dev --active --python "$venv/bin/python"
	python scripts/patch_lxst_pyogg_ogg_ctypes.py
}

build() {
	cd "$srcdir/MeshChatX"
	export PNPM_HOME="$srcdir/.pnpm-home"
	export PYTHON_CMD="$srcdir/MeshChatX/.build-venv/bin/python"
	# visualiser-wasm is built with TinyGo. Arch's tinygo (0.41.1) rejects
	# the Go 1.27 toolchain, so use the pinned upstream release.
	export TINYGO="$srcdir/tinygo/bin/tinygo"
	local arch_seg goarch
	case "$CARCH" in
	x86_64)
		arch_seg=x64
		goarch=amd64
		;;
	aarch64)
		arch_seg=arm64
		goarch=arm64
		;;
	*)
		echo "unsupported CARCH: $CARCH" >&2
		return 1
		;;
	esac

	PLATFORM=linux ARCH="$arch_seg" pnpm run build

	# Wails3 CLI for the desktop shell, same pin as upstream CI.
	if ! command -v wails3 >/dev/null 2>&1; then
		go install github.com/wailsapp/wails/v3/cmd/wails3@v3.1.0
	fi
	export PATH="$(go env GOPATH)/bin:$PATH"

	cd desktop
	# Arch's go-task package ships the binary as go-task, not task.
	go-task linux:build PRODUCTION=true ARCH="$goarch"
	[ -x bin/meshchatx-desktop ]
	[ -f bin/backend/ReticulumMeshChatX ]
}

package() {
	cd "$srcdir/MeshChatX"

	# Wails shell plus the frozen Python backend. The shell finds the
	# backend at <self>/backend/ReticulumMeshChatX (desktop/internal/paths).
	install -d "$pkgdir/usr/lib/meshchatx/backend"
	install -m755 desktop/bin/meshchatx-desktop "$pkgdir/usr/lib/meshchatx/meshchatx"
	cp -a desktop/bin/backend/. "$pkgdir/usr/lib/meshchatx/backend/"

	install -d "$pkgdir/usr/bin"
	ln -sfn /usr/lib/meshchatx/meshchatx "$pkgdir/usr/bin/meshchatx"
	ln -sfn meshchatx "$pkgdir/usr/bin/reticulum-meshchatx"

	install -Dm644 logo/logo.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/meshchatx.png"
	install -d "$pkgdir/usr/share/applications"
	cat >"$pkgdir/usr/share/applications/meshchatx.desktop" <<'EOF'
[Desktop Entry]
Name=Reticulum MeshChatX
Comment=All-in-one Reticulum client
Exec=meshchatx
Icon=meshchatx
Terminal=false
Type=Application
Categories=Network;
MimeType=x-scheme-handler/lxmf;x-scheme-handler/rns;
StartupWMClass=meshchatx-desktop
EOF
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
