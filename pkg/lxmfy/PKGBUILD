pkgname=lxmfy
pkgver=2.1.1
pkgrel=1
pkgdesc='LXMF bot framework for the Reticulum Network'
arch=('any')
url='https://github.com/Quad4-Software/LXMFy'
license=('0BSD')
depends=('python' 'rns' 'lxmf' 'python-cbor2')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'python-poetry-core')
options=('!strip')
install=lxmfy.install
source=("https://files.pythonhosted.org/packages/be/be/bfbefd06a9aa4b7ee596c488688397e05a1cdf6cb0df1fc3c6deea3807f6/lxmfy-2.1.1.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('6f1001a5988b6094f23734ccd313a704b201aafc0eb945ddf4d8f88193301be3')
# AUTO-SUMS-END

build() {
	cd "$srcdir/lxmfy-2.1.1"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/lxmfy-2.1.1"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
