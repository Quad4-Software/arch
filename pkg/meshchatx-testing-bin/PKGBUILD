# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=meshchatx-testing-bin
pkgver=4.9.1.2026.09.18.4616be5
pkgrel=1
pkgdesc='All-in-one Reticulum client (prebuilt testing AppImage)'
arch=('x86_64' 'aarch64')
url='https://github.com/Quad4-Software/MeshChatX'
license=('0BSD' 'MIT')
depends=('fuse2')
optdepends=('noto-fonts-emoji: color emoji in the UI')
provides=('meshchatx' 'reticulum-meshchatx')
conflicts=('meshchatx-bin' 'meshchatx-git' 'meshchatx-beta-bin')
options=('!strip' '!debug')
install=meshchatx-testing-bin.install
_tag=nightly-2026.09.18-4616be5
_appver=4.9.1
source=("https://github.com/Quad4-Software/MeshChatX/archive/refs/tags/${_tag}.tar.gz")
source_x86_64=("ReticulumMeshChatX-v${_appver}-linux-x86_64.AppImage::https://github.com/Quad4-Software/MeshChatX/releases/download/${_tag}/ReticulumMeshChatX-v${_appver}-linux-x86_64.AppImage")
source_aarch64=("ReticulumMeshChatX-v${_appver}-linux-arm64.AppImage::https://github.com/Quad4-Software/MeshChatX/releases/download/${_tag}/ReticulumMeshChatX-v${_appver}-linux-arm64.AppImage")
# AUTO-SUMS-BEGIN
sha256sums=('46bdd0774b42135b1019bb45ec2992b9fa4370b52453e45de103059507d2142f')
sha256sums_x86_64=('af5353fb7a84687f0b053db8e4da2561284a543e2ece5b4011bd34e9634c76f4')
sha256sums_aarch64=('474a9e458f2b7b48b8979149023bb57fca55ce19a7507a5aa14b9edac7309aef')
# AUTO-SUMS-END

package() {
	local appimage srcdir_src
	case "$CARCH" in
	x86_64) appimage="ReticulumMeshChatX-v${_appver}-linux-x86_64.AppImage" ;;
	aarch64) appimage="ReticulumMeshChatX-v${_appver}-linux-arm64.AppImage" ;;
	*)
		echo "unsupported CARCH: $CARCH" >&2
		return 1
		;;
	esac
	srcdir_src="$srcdir/MeshChatX-${_tag}"

	install -Dm755 "$srcdir/$appimage" "$pkgdir/opt/meshchatx/meshchatx.AppImage"
	install -d "$pkgdir/usr/bin"
	cat >"$pkgdir/usr/bin/meshchatx" <<'EOF'
#!/bin/sh
export APPIMAGE_EXTRACT_AND_RUN="${APPIMAGE_EXTRACT_AND_RUN:-1}"
exec /opt/meshchatx/meshchatx.AppImage "$@"
EOF
	chmod 755 "$pkgdir/usr/bin/meshchatx"
	ln -sfn meshchatx "$pkgdir/usr/bin/reticulum-meshchatx"

	install -Dm644 "$srcdir_src/logo/logo.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/meshchatx.png"
	install -d "$pkgdir/usr/share/applications"
	cat >"$pkgdir/usr/share/applications/meshchatx.desktop" <<'EOF'
[Desktop Entry]
Name=Reticulum MeshChatX
Comment=All-in-one Reticulum client
Exec=meshchatx
Icon=meshchatx
Terminal=false
Type=Application
Categories=Network;
StartupWMClass=reticulum-meshchatx
EOF
	install -Dm644 "$srcdir_src/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
