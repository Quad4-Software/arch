# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=nullray-bin
pkgver=0.3.0
pkgrel=1
pkgdesc='Lightweight coding agent with a custom TUI'
arch=('x86_64' 'aarch64')
url='https://github.com/Quad4-Software/nullray'
license=('0BSD')
provides=('nullray')
conflicts=('nullray-git')
replaces=('nullray')
options=('!debug')
install=nullray-bin.install
source=("https://github.com/Quad4-Software/nullray/archive/refs/tags/v${pkgver}.tar.gz")
source_x86_64=("nullray_${pkgver}_linux_amd64.tar.gz::https://github.com/Quad4-Software/nullray/releases/download/v${pkgver}/nullray_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("nullray_${pkgver}_linux_arm64.tar.gz::https://github.com/Quad4-Software/nullray/releases/download/v${pkgver}/nullray_${pkgver}_linux_arm64.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('c2e39da3586990f579c7c0faa8ef558e7b95de4f81845b283ca758df06d17b49')
sha256sums_x86_64=('db2cbfce4c0739e5592cebfbbfc69fc6587da0b36f0ebac350ce2759dd909725')
sha256sums_aarch64=('8271821613e1f0a81924444cdd1acd99aa0c9c3f32f75e819da67cac2d620a5a')
# AUTO-SUMS-END

package() {
	local bin srcdir_src
	case "$CARCH" in
	x86_64) bin="nullray_${pkgver}_linux_amd64" ;;
	aarch64) bin="nullray_${pkgver}_linux_arm64" ;;
	*)
		echo "unsupported CARCH: $CARCH" >&2
		return 1
		;;
	esac
	srcdir_src="$srcdir/nullray-${pkgver}"

	install -Dm755 "$srcdir/$bin" "$pkgdir/usr/bin/nullray"

	if [ -f "$srcdir_src/man/nullray.1" ]; then
		install -Dm644 "$srcdir_src/man/nullray.1" "$pkgdir/usr/share/man/man1/nullray.1"
	fi

	install -d "$pkgdir/usr/share/nullray/completions"
	install -d "$pkgdir/usr/share/bash-completion/completions"
	install -d "$pkgdir/usr/share/zsh/site-functions"
	install -d "$pkgdir/usr/share/fish/vendor_completions.d"

	install -m644 "$srcdir_src/contrib/completions/nullray.bash" "$pkgdir/usr/share/nullray/completions/nullray.bash"
	install -m644 "$srcdir_src/contrib/completions/nullray.bash" "$pkgdir/usr/share/bash-completion/completions/nullray"
	install -m644 "$srcdir_src/contrib/completions/nullray.zsh" "$pkgdir/usr/share/zsh/site-functions/_nullray"
	install -m644 "$srcdir_src/contrib/completions/nullray.fish" "$pkgdir/usr/share/fish/vendor_completions.d/nullray.fish"

	install -Dm644 "$srcdir_src/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
