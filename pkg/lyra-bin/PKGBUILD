# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=lyra-bin
pkgver=0.1.0
pkgrel=1
epoch=1
pkgdesc='Privacy-focused Firefox ESR fork (prebuilt release)'
arch=('x86_64')
url='https://github.com/lyrabrowserhq/lyra-browser'
license=('MPL-2.0')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus-glib' 'ffmpeg' 'fontconfig' 'freetype2' 'gdk-pixbuf2' 'glib2' 'gtk3' 'hicolor-icon-theme' 'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxrandr' 'libxss' 'libxt' 'mime-types' 'nspr' 'nss' 'pango' 'ttf-font')
optdepends=('hunspell-en_US: spell checking' 'libnotify: notification integration' 'libpulse: audio' 'speech-dispatcher: text to speech' 'xdg-desktop-portal: screensharing and file portals')
provides=('lyra')
conflicts=('lyra-git')
replaces=('lyra')
options=('!strip' '!debug' '!emptydirs')
install=lyra-bin.install
source=("https://github.com/lyrabrowserhq/lyra-browser/archive/refs/tags/v${pkgver}.tar.gz")
source_x86_64=("lyra-${pkgver}-linux-x86_64.tar.xz::https://github.com/lyrabrowserhq/lyra-browser/releases/download/v${pkgver}/lyra-${pkgver}-linux-x86_64.tar.xz")
# AUTO-SUMS-BEGIN
sha256sums=('4deef5ee24131d7f3f7981f06c3a03c7a570c9f4885a386e3512408baebed6cf')
sha256sums_x86_64=('44815a74ef0c9cc0fd20ef1ccbd8f5083b0833f5e8ecb1714ed3b99a04bec161')
# AUTO-SUMS-END

package() {
	local dist="lyra-${pkgver}-linux-x86_64"
	local repo="lyra-browser-${pkgver}"

	install -d "$pkgdir/usr/lib"
	cp -a "$srcdir/$dist" "$pkgdir/usr/lib/lyra"

	install -d "$pkgdir/usr/bin"
	ln -s /usr/lib/lyra/lyra "$pkgdir/usr/bin/lyra"

	install -Dm644 "$srcdir/$repo/overlay/linux/com.lyrabrowser.lyra.desktop" \
		"$pkgdir/usr/share/applications/com.lyrabrowser.lyra.desktop"

	local size
	for size in 16 32 48 64 128; do
		install -Dm644 "$pkgdir/usr/lib/lyra/browser/chrome/icons/default/default${size}.png" \
			"$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/lyra.png"
	done

	install -Dm644 "$srcdir/$repo/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
