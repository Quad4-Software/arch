pkgname=rns
pkgver=1.5.6
pkgrel=1
pkgdesc='Reticulum Network Stack (Python)'
arch=('any')
url='https://reticulum.network/'
license=('custom:Reticulum')
depends=('python' 'python-cryptography' 'python-pyserial')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=rns.install
source=("https://files.pythonhosted.org/packages/63/b9/aca7c31217b322904b51daca52756d8a5b68291b4b2d0c081dbf8f0b4a09/rns-1.5.6.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('57a2498a6581e994b088ad815f096b7c23ed321e3909b44fe1589f8b08506898')
# AUTO-SUMS-END

build() {
	cd "$srcdir/rns-1.5.6"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/rns-1.5.6"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
