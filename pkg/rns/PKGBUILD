pkgrel=1
pkgdesc='Reticulum Network Stack (Python)'
arch=('any')
url='https://reticulum.network/'
license=('custom:Reticulum')
depends=('python' 'python-cryptography' 'python-pyserial')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=rns.install
source=("https://files.pythonhosted.org/packages/eb/62/ec929e1a614e0d9f5266f816d73a060eb6b0c89f6684e9ef0b7bedcac17d/rns-1.5.7.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('2bb48232e0a10b59b2b21b60e76592362210cdabd343d7b97a3bf1aba22dd879')
# AUTO-SUMS-END

build() {
	cd "$srcdir/rns-1.5.7"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/rns-1.5.7"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
