pkgname=rns
pkgver=1.5.2
pkgrel=1
pkgdesc='Reticulum Network Stack (Python)'
arch=('any')
url='https://reticulum.network/'
license=('custom:Reticulum')
depends=('python' 'python-cryptography' 'python-pyserial')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=rns.install
source=("https://files.pythonhosted.org/packages/7e/fb/d7b0b67c0e369b8533fe14688cb2b65bff21c669b0c776759015ad3d1830/rns-1.5.2.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('a7f8f0d445312fee1c4ade41178f5224fe7af8bd790a79d148696659d81cc862')
# AUTO-SUMS-END

build() {
	cd "$srcdir/rns-1.5.2"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/rns-1.5.2"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
