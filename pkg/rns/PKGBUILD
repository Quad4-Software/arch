pkgname=rns
pkgver=1.6.0
pkgrel=1
pkgdesc='Reticulum Network Stack (Python)'
arch=('any')
url='https://reticulum.network/'
license=('custom:Reticulum')
depends=('python' 'python-cryptography' 'python-pyserial')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=rns.install
source=("https://files.pythonhosted.org/packages/d0/21/c7d27dba5ff43a24d806678497c7f85273ccd23cd43cc9fc9cefb2ab3b30/rns-1.6.0.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('aa99d550dacd0c895d81cac6d0740fbd8e89bdb3d452c555a51ef2305a6e5e4d')
# AUTO-SUMS-END

build() {
	cd "$srcdir/rns-1.6.0"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/rns-1.6.0"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
