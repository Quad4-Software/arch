pkgname=rns
pkgver=1.5.5
pkgrel=1
pkgdesc='Reticulum Network Stack (Python)'
arch=('any')
url='https://reticulum.network/'
license=('custom:Reticulum')
depends=('python' 'python-cryptography' 'python-pyserial')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=rns.install
source=("https://files.pythonhosted.org/packages/02/12/9e28be4983a2dc826c2dabc35786cc3ae4bd340973b622ce3c17a0df7451/rns-1.5.5.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('94f2352c7462e2fcf485d5c770eb2b41e666b753906ac3ce0a94e8a0c489a460')
# AUTO-SUMS-END

build() {
	cd "$srcdir/rns-1.5.5"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/rns-1.5.5"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
