pkgname=rns
pkgver=1.5.4
pkgrel=1
pkgdesc='Reticulum Network Stack (Python)'
arch=('any')
url='https://reticulum.network/'
license=('custom:Reticulum')
depends=('python' 'python-cryptography' 'python-pyserial')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=rns.install
source=("https://files.pythonhosted.org/packages/91/15/517d2e63e876a677088673853f9c947340cd2056716328f3ba4e888ae47c/rns-1.5.4.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('578508ef08dedf7c109f73a445065ca89c50a63c6a69ced7b147ed20391ceb15')
# AUTO-SUMS-END

build() {
	cd "$srcdir/rns-1.5.4"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/rns-1.5.4"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
