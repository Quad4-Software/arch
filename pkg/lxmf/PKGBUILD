# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=lxmf
pkgver=1.2.0
pkgrel=1
pkgdesc='Lightweight Extensible Message Format for Reticulum'
arch=('any')
url='https://github.com/markqvist/lxmf'
license=('custom:Reticulum')
depends=('python' 'rns')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=lxmf.install
source=("https://files.pythonhosted.org/packages/15/e0/4e1efc0f20abd41a9ea2c01a5f1870b452f85c7cc710f74f45dd979d520b/lxmf-1.2.0.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('f14243283b90ad06356071d90394357640924201f9c992dcdfecbc23614fb309')
# AUTO-SUMS-END

build() {
	cd "$srcdir/lxmf-1.2.0"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/lxmf-1.2.0"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
