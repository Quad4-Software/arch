# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=lxmf
pkgver=1.2.1
pkgrel=1
pkgdesc='Lightweight Extensible Message Format for Reticulum'
arch=('any')
url='https://github.com/markqvist/lxmf'
license=('custom:Reticulum')
depends=('python' 'rns')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=lxmf.install
source=("https://files.pythonhosted.org/packages/17/c4/9042fcd535e815efc8baebad5fdc3eb2bb308500c781ec828a4e60a532e5/lxmf-1.2.1.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('acb1551066406de97c6aacaa38cf512131b60167db5ab5787a525d1d2586b304')
# AUTO-SUMS-END

build() {
	cd "$srcdir/lxmf-1.2.1"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/lxmf-1.2.1"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
