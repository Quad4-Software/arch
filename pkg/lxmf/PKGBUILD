# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=lxmf
pkgver=1.3.1
pkgrel=1
pkgdesc='Lightweight Extensible Message Format for Reticulum'
arch=('any')
url='https://github.com/markqvist/lxmf'
license=('custom:Reticulum')
depends=('python' 'rns')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=lxmf.install
source=("https://files.pythonhosted.org/packages/2a/a8/d46a65ccb4582c6aa73e2562f64518eb8b9398201287d4b02798f3208055/lxmf-1.3.1.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('f74e728197a9599a1f694cb057b82f6c896bf20ded8613eeb1b167df02bb199f')
# AUTO-SUMS-END

build() {
	cd "$srcdir/lxmf-1.3.1"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/lxmf-1.3.1"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
