# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=lxmf
pkgver=1.3.0
pkgrel=1
pkgdesc='Lightweight Extensible Message Format for Reticulum'
arch=('any')
url='https://github.com/markqvist/lxmf'
license=('custom:Reticulum')
depends=('python' 'rns')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=lxmf.install
source=("https://files.pythonhosted.org/packages/9e/e1/63ea52b108e27955511890af09509d492a7c3d5077a2470e24886f28e9a2/lxmf-1.3.0.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('5847534a7e69768425e02ff159096baf385ac99c0919da79e9ed0100e8f46814')
# AUTO-SUMS-END

build() {
	cd "$srcdir/lxmf-1.3.0"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/lxmf-1.3.0"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
