# shellcheck shell=sh
post_install() {
	printf '%s\n' 'void-search-git is installed (void-search from git).'
	printf '%s\n' 'systemd: systemctl enable --now void-search'
	printf '%s\n' 'Listens on 127.0.0.1:8080. Settings: /etc/void-search/settings.yml'
	printf '%s\n' 'The limiter and public_instance need valkey running.'
}

post_upgrade() {
	true
}

post_remove() {
	true
}
