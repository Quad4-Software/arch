# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=pip-rns
pkgver=1.3.1
pkgrel=1
pkgdesc='Install Python packages from Reticulum rngit remotes'
arch=('any')
url='https://github.com/Quad4-Software/pip-rns'
license=('BSD-2-Clause')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'python-hatchling')
options=('!strip')
install=pip-rns.install
source=("https://files.pythonhosted.org/packages/1d/0c/045d385876e4cdc38fd16488c25c457d50521158ce5a579bd3b18ef6a498/pip_rns-1.3.1.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('fa996d7386a75e034b2bacdf79bd9230d535d9de5105263383c3d38d53af35a0')
# AUTO-SUMS-END

build() {
	cd "$srcdir/pip_rns-1.3.1"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/pip_rns-1.3.1"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
