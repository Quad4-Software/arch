# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=pip-rns
pkgver=1.5.0
pkgrel=1
pkgdesc='Install Python packages from Reticulum rngit remotes'
arch=('any')
url='https://github.com/Quad4-Software/pip-rns'
license=('BSD-2-Clause')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'python-hatchling')
options=('!strip')
install=pip-rns.install
source=("https://files.pythonhosted.org/packages/62/a6/ae1d9a3745822c2afbd6975ef0f5b2a1c286b3dfc9fb0a631609c5556cad/pip_rns-1.5.0.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('bd0766be58c9528eb013c82bdc39639d83b5e4472a8ca8bab9c47167ede6e266')
# AUTO-SUMS-END

build() {
	cd "$srcdir/pip_rns-1.5.0"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/pip_rns-1.5.0"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
