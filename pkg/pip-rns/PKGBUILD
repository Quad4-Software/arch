# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=pip-rns
pkgver=1.4.0
pkgrel=1
pkgdesc='Install Python packages from Reticulum rngit remotes'
arch=('any')
url='https://github.com/Quad4-Software/pip-rns'
license=('BSD-2-Clause')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'python-hatchling')
options=('!strip')
install=pip-rns.install
source=("https://files.pythonhosted.org/packages/70/37/74ad378b996ac0915e60fed1733d1004f389edd0bd30412eb35cfde86d53/pip_rns-1.4.0.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('1ffe5d8c18709038e39d4c03fc827a7f2dc20fce74f2ce85320d84e0d3eca03c')
# AUTO-SUMS-END

build() {
	cd "$srcdir/pip_rns-1.4.0"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/pip_rns-1.4.0"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
