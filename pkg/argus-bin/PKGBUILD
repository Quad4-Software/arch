# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=argus-bin
pkgver=0.2.0
pkgrel=1
pkgdesc='All-in-one security, OSINT and linting tool (prebuilt release binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/Quad4-Software/argus'
license=('custom:QSL-1.0-0BSD')
provides=('argus')
conflicts=('argus-git')
replaces=('argus')
options=('!debug')
install=argus-bin.install
source_x86_64=("argus-v${pkgver}-x86_64-unknown-linux-musl.tar.gz::https://github.com/Quad4-Software/argus/releases/download/v${pkgver}/argus-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("argus-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz::https://github.com/Quad4-Software/argus/releases/download/v${pkgver}/argus-v${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums_x86_64=('c23c9945b2b84a8117370c295fb251309adeeccb1e48a6c2c42767bb612ba008')
sha256sums_aarch64=('10cd808d8638cb75411fc2e0e1ae345fbc9163ee5f98cd12944b3824b32ab509')
# AUTO-SUMS-END

package() {
	local dir
	case "$CARCH" in
	x86_64) dir="argus-v${pkgver}-x86_64-unknown-linux-musl" ;;
	aarch64) dir="argus-v${pkgver}-aarch64-unknown-linux-gnu" ;;
	*)
		echo "unsupported CARCH: $CARCH" >&2
		return 1
		;;
	esac
	install -Dm755 "$srcdir/$dir/argus" "$pkgdir/usr/bin/argus"
	install -Dm644 "$srcdir/$dir/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
