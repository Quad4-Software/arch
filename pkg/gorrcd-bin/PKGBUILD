package() {
	local binfile
	case "$CARCH" in
	x86_64) binfile="gorrcd-linux-amd64-${pkgver}" ;;
	aarch64) binfile="gorrcd-linux-arm64-${pkgver}" ;;
	armv7h) binfile="gorrcd-linux-armv6-${pkgver}" ;;
	*)
		echo "unsupported CARCH: $CARCH" >&2
		return 1
		;;
	esac
	install -Dm755 "$srcdir/$binfile" "$pkgdir/usr/bin/gorrcd"
}
