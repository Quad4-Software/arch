# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=renbrowser-bin
pkgver=0.5.1
pkgrel=1
pkgdesc='Modern browser for the Reticulum Network (Reticulum-Go)'
arch=('x86_64' 'aarch64')
url='https://github.com/Quad4-Software/Ren-Browser'
license=('MIT')
provides=('renbrowser')
conflicts=('renbrowser-git')
replaces=('renbrowser')
options=('!strip' '!debug')
install=renbrowser-bin.install
source=("https://github.com/Quad4-Software/Ren-Browser/archive/refs/tags/v${pkgver}.tar.gz")
source_x86_64=("renbrowser-linux-amd64-${pkgver}::https://github.com/Quad4-Software/Ren-Browser/releases/download/v${pkgver}/renbrowser-linux-amd64")
source_aarch64=("renbrowser-linux-arm64-${pkgver}::https://github.com/Quad4-Software/Ren-Browser/releases/download/v${pkgver}/renbrowser-linux-arm64")
# AUTO-SUMS-BEGIN
sha256sums=('c929c9fbeb10648205b760030b3ad9063c0d787913aacbd836237e7c49baf5c6')
sha256sums_x86_64=('03a1c4629d497680b19ba4f5dfff5782f3ca5c5f711b1d9b40526e5266d0e53b')
sha256sums_aarch64=('7ee85dcc3b8d59dc1d8871decb7132cb2f9a2f4cb37d3242b5df79a9902fc62a')
# AUTO-SUMS-END

package() {
	local bin srcdir_src
	case "$CARCH" in
	x86_64) bin="renbrowser-linux-amd64-${pkgver}" ;;
	aarch64) bin="renbrowser-linux-arm64-${pkgver}" ;;
	*)
		echo "unsupported CARCH: $CARCH" >&2
		return 1
		;;
	esac
	srcdir_src="$srcdir/Ren-Browser-${pkgver}"
	install -Dm755 "$srcdir/$bin" "$pkgdir/usr/bin/renbrowser"
	if [ -f "$srcdir_src/LICENSE" ]; then
		install -Dm644 "$srcdir_src/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
	fi
}
