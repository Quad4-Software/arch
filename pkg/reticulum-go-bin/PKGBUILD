# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=reticulum-go-bin
pkgver=1.4.1
pkgrel=1
pkgdesc='Reticulum network stack (Go), prebuilt release binary'
arch=('x86_64' 'aarch64' 'armv7h')
url='https://github.com/Quad4-Software/Reticulum-Go'
license=('Apache-2.0')
provides=('reticulum-go')
conflicts=('reticulum-go-git')
replaces=('reticulum-go')
backup=('var/lib/reticulum-go/config')
options=('!debug')
makedepends=('make')
install=reticulum-go-bin.install
source=("https://github.com/Quad4-Software/Reticulum-Go/archive/refs/tags/v${pkgver}.tar.gz")
source_x86_64=("reticulum-go-linux-amd64-${pkgver}::https://github.com/Quad4-Software/Reticulum-Go/releases/download/v${pkgver}/reticulum-go-linux-amd64")
source_aarch64=("reticulum-go-linux-arm64-${pkgver}::https://github.com/Quad4-Software/Reticulum-Go/releases/download/v${pkgver}/reticulum-go-linux-arm64")
source_armv7h=("reticulum-go-linux-arm-${pkgver}::https://github.com/Quad4-Software/Reticulum-Go/releases/download/v${pkgver}/reticulum-go-linux-arm")
# AUTO-SUMS-BEGIN
sha256sums=('37a1cba87eeb2bccf23a57b18dcc803702b1d95fd4afbb7552cc738fb30259a7')
sha256sums_x86_64=('fd559a9eb5390a97212cc9a8c689a5d5d33a97210dceed5562bb9c7d9c5950d7')
sha256sums_aarch64=('ed136ca6c60dae28c0b683220f21584c081d48e261c296a712d8adbc6b11a7f5')
sha256sums_armv7h=('681a05e6e31aa1bb5a19c3ecc74e8ab8c7e2bf42540e81c506b4b1b2dbe28836')
# AUTO-SUMS-END

package() {
	local bin srcdir_go
	case "$CARCH" in
	x86_64) bin="reticulum-go-linux-amd64-${pkgver}" ;;
	aarch64) bin="reticulum-go-linux-arm64-${pkgver}" ;;
	armv7h) bin="reticulum-go-linux-arm-${pkgver}" ;;
	*)
		echo "unsupported CARCH: $CARCH" >&2
		return 1
		;;
	esac
	srcdir_go="$srcdir/Reticulum-Go-${pkgver}"

	install -Dm755 "$srcdir/$bin" "$pkgdir/usr/bin/reticulum-go"
	make -C "$srcdir_go" DESTDIR="$pkgdir" PREFIX=/usr install-man
	make -C "$srcdir_go" DESTDIR="$pkgdir" PREFIX=/usr BINDIR=/usr/bin INIT=all install-service
	install -Dm644 "$srcdir_go/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"

	local name
	for name in rgostatus rgoid rgoprobe rgopath rgocp rgox rnx rgosh rgopageserver rgoslow rgoselfcheck rgospeed rgodump rgosnap; do
		ln -sfn reticulum-go "$pkgdir/usr/bin/$name"
	done
}
