# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=nomadnet
pkgver=1.5.0
pkgrel=1
pkgdesc='Off-grid encrypted messaging client for Reticulum'
arch=('any')
url='https://github.com/markqvist/nomadnet'
license=('MIT')
depends=('python' 'rns' 'lxmf' 'python-urwid' 'python-qrcode')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=nomadnet.install
source=("https://files.pythonhosted.org/packages/a3/56/280fb8eb658d2d7aacd88e95f8ec6f9f4fa720926b8484fe4fb25a0018a3/nomadnet-1.5.0.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('4c064387199d9cd32b62c7d83ce770dfb6fe24d4092ed65758d0f6b3ef58b9bf')
# AUTO-SUMS-END

build() {
	cd "$srcdir/nomadnet-1.5.0"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/nomadnet-1.5.0"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
