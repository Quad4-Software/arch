# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=nomadnet
pkgver=1.4.3
pkgrel=1
pkgdesc='Off-grid encrypted messaging client for Reticulum'
arch=('any')
url='https://github.com/markqvist/nomadnet'
license=('MIT')
depends=('python' 'rns' 'lxmf' 'python-urwid' 'python-qrcode')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=nomadnet.install
source=("https://files.pythonhosted.org/packages/42/af/4391df610ed2c66841a8b0e1c090b9380483cc344ac98345d97ac761ae2d/nomadnet-1.4.3.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('c256bb5ef88dfa3de45b6fa02a2af2e0e313b7b0c34c9c510395f0418976299d')
# AUTO-SUMS-END

build() {
	cd "$srcdir/nomadnet-1.4.3"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/nomadnet-1.4.3"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
