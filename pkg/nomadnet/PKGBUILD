# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=nomadnet
pkgver=1.4.1
pkgrel=1
pkgdesc='Off-grid encrypted messaging client for Reticulum'
arch=('any')
url='https://github.com/markqvist/nomadnet'
license=('MIT')
depends=('python' 'rns' 'lxmf' 'python-urwid' 'python-qrcode')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=nomadnet.install
source=("https://files.pythonhosted.org/packages/ec/90/bc8025a532814d00dc3ad97442853c6816674c585dd6ef50a947184a4498/nomadnet-1.4.1.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('eec6e64419a35b4d6f1f6c79fa73d416cc111253bc43ffbfa76fbe35fd57f747')
# AUTO-SUMS-END

build() {
	cd "$srcdir/nomadnet-1.4.1"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/nomadnet-1.4.1"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
