# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=nomadnet
pkgver=1.3.1
pkgrel=1
pkgdesc='Off-grid encrypted messaging client for Reticulum'
arch=('any')
url='https://github.com/markqvist/nomadnet'
license=('MIT')
depends=('python' 'rns' 'lxmf' 'python-urwid' 'python-qrcode')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=nomadnet.install
source=("https://files.pythonhosted.org/packages/b5/d1/1322840b8449e377bc52580399f2cf03dd884cf096f59bae51cbaad7f4ac/nomadnet-1.3.1.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('cbb9f4b237eadd25874c801d2a2266fda954a26fa7355a084ed20050994eef3f')
# AUTO-SUMS-END

build() {
	cd "$srcdir/nomadnet-1.3.1"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/nomadnet-1.3.1"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
