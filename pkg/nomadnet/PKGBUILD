# Maintainer: Quad4.io <ivan@quad4.io>
pkgname=nomadnet
pkgver=1.5.1
pkgrel=1
pkgdesc='Off-grid encrypted messaging client for Reticulum'
arch=('any')
url='https://github.com/markqvist/nomadnet'
license=('MIT')
depends=('python' 'rns' 'lxmf' 'python-urwid' 'python-qrcode')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
options=('!strip')
install=nomadnet.install
source=("https://files.pythonhosted.org/packages/64/6d/d60ec43dabba7bda681e49ad76ac133b5ccb2b2588581b9486d1672e287a/nomadnet-1.5.1.tar.gz")
# AUTO-SUMS-BEGIN
sha256sums=('fc340de0f14b313ebfe81f07ac1c836a84077766308b73f2df358134b71deed6')
# AUTO-SUMS-END

build() {
	cd "$srcdir/nomadnet-1.5.1"
	python -m build --wheel --no-isolation
}

package() {
	cd "$srcdir/nomadnet-1.5.1"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
